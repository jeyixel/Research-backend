# Paths are resolved against this backend directory, never the terminal's cwd.
MODULE_C_TRAINING_TABLE=../data-collector/data/training_table.csv
MODULE_C_COLLECTOR_ROOT=../data-collector
MODULE_C_ARTIFACTS=artifacts/module_c
MODULE_C_CLIP_MODEL=openai/clip-vit-base-patch32
MODULE_C_CLIP_REVISION=main
MODULE_C_DEVICE=auto
MODULE_C_BATCH_SIZE=32
# OCR is optional. Enable after downloading its detector with the extract command.
MODULE_C_OCR_ENABLED=true

# Use local rules for demos. Opt into "gemini" only when ready to use its wording adapter.
MODULE_C_WRITER=rules
GEMINI_API_KEY=
MODULE_C_GEMINI_MODEL=gemini-3.5-flash-lite
MODULE_C_WRITER_TIMEOUT_SECONDS=8
MODULE_C_GEMINI_REQUESTS_PER_MINUTE=2
MODULE_C_GEMINI_REQUESTS_PER_DAY=20
